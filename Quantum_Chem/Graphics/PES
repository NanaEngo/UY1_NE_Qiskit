\begin{tikzpicture}
    \begin{axis}[
        xlabel={Bond length (Å)},
        ylabel={Energy (Hartree)},
        title={Ground state energy of H$_2$},
        grid=major,
        xmin=0.3, xmax=3,
        ymin=-1.2, ymax=0,
        domain=0.3:3,
        samples=100,
        ticklabel style={font=\small},
        label style={font=\small},
        title style={font=\small}
    ]
        % Fonction corrigée pour assurer un minimum à R = 0.74 Å
        \addplot[blue, thick] { -1.1 + 0.2 * (1 - exp(-3.3*(x-0.74)))^2 };

        % Point d'équilibre à R = 0.74 Å
        \addplot[red, mark=*, only marks] coordinates {(0.74,-1.1)};
        \node[red, font=\small,below] at (axis cs:1.1,-1.1) {Équilibre $r_e = 0.74$ Å};

    \end{axis}
\end{tikzpicture}
